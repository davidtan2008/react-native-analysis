  "cards": [
    {
      "dot": "emerald",
      "title": "真正可用的",
      "items": [
        "崩溃：JS 异常全链路分层兜底，DEV 有 LogBox / RedBox，PROD 分发到宿主",
        "启动：ReactMarker 17 个打点 + performance.rnStartupTiming 数据出口"
      ]
    },
    {
      "dot": "amber",
      "title": "部分覆盖",
      "items": [
        "OOM：只能被动响应系统 onTrimMemory，无堆上限与 OOM 预测（jsHeapSizeLimit 恒 null）",
        "卡顿：longtask 50ms 阈值 + Event Timing，仅推 DevTools 无持久化",
        "泄漏：LeakChecker 仅 Debug 编译，且漏检最后一个 surface"
      ]
    },
    {
      "dot": "rose",
      "title": "明确缺失",
      "items": [
        "白屏：无任何检测或看门狗，Surface 在首帧前即置 Running",
        "内容增长：无速率监控，_cellMetrics 在唯一 key 场景无界增长",
        "原生崩溃：无 signal / uncaught-exception 钩子，完全交给系统"
      ]
    }
  ]
