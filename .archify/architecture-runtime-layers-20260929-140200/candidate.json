  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "自上而下单向：业务代码 → 渲染器 → ReactInstance → UIManager → 挂载 → 平台视图",
        "UIManager→挂载 的 pullTransaction 在主线程执行，产出 ShadowViewMutation 列表"
      ]
    },
    {
      "dot": "emerald",
      "title": "线程与执行域",
      "items": [
        "ReactInstance 及其 RuntimeScheduler 运行在唯一 JS 线程",
        "MountingCoordinator::pullTransaction 与平台挂载在主线程 / UI 线程",
        "JSI 是 C++ 直连引擎的边界，取代了旧 Bridge 的 JSON 序列化"
      ]
    },
    {
      "dot": "rose",
      "title": "横切能力（右侧）",
      "items": [
        "JsErrorHandler 是全平台唯一错误中枢，产出统一 ProcessedError 数据契约",
        "ReactMarker::logTaggedMarkerImpl 是全局单槽位，App 监听启动打点会覆盖 RN 自身记录器",
        "jsinspector 提供完整 CDP 通道，但 Release 默认关闭（fuseboxEnabledRelease=false）"
      ]
    },
    {
      "dot": "amber",
      "title": "源码缺口",
      "items": [
        "Hermes 引擎在 ReactCommon 之外，TTI 感知的 GC 策略 allocInOldGenBeforeTTI 两端均硬编码为 false",
        "Fabric 只向 iOS 暴露 Preparing / Running 两个聚合阶段，首帧渲染完成的细分阶段从未实现"
      ]
    }
  ]
